{{!
    @template theme_academi/carousel

    Renders a Bootstrap carousel

    Example context (json):
    {
        "items": [
            {
                "image": "image_url_1",
                "title": "Title 1",
                "description": "Description 1"
            },
            {
                "image": "image_url_2",
                "title": "Title 2",
                "description": "Description 2"
            }
        ]
    }
}}

<div id="carouselExample" class="carousel slide" data-ride="carousel">
    <ol class="carousel-indicators">
    {{#items}}
      <li data-target="#{{../carouselId}}" data-slide-to="{{@index}}" {{#first}}class="active"{{/first}}></li>
    {{/items}}
  </ol>
  <div class="carousel-inner">
    {{#items}}
      <div class="carousel-item {{#first}}active{{/first}}">
        <img style="width: 360px; height: 360px; object-fit: cover;" src="{{image}}" class="d-block w-100" alt="{{title}}">
        {{! <div class="carousel-caption d-none d-md-block">
        </div> }}
      </div>
    {{/items}}
  </div>
  <a class="carousel-control-prev" href="#carouselExample" role="button" data-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="sr-only">Previous</span>
  </a>
  <a class="carousel-control-next" href="#carouselExample" role="button" data-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="sr-only">Next</span>
  </a>
</div>